        {
          statement:
            "The API validates the JWT on every request.",
          risk: "Low",
          reason:
            "This is reasonable, but an interviewer may ask what validation actually includes.",
          followUps: [
            "What exactly do you validate in the JWT?",
            "How do you verify the signature?",
          ],
          preparation:
            "Review signature verification, expiration, issuer, audience, and authorization checks.",
        },
      ],
      strengths: [
        "Identifies JWT as an authentication mechanism.",
