                          <ChevronDown size={18} />
                        )}

                      </div>

                    </div>

                    {expandedQuestion === index && (

                      <div className="mt-4 pt-4 border-t border-black/10 dark:border-white/10">

                        <p className="text-sm leading-6">
                          {item.statement}
