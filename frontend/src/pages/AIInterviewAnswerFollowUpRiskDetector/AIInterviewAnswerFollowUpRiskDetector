    if (score >= 85) return "Follow-Up Ready";
    if (score >= 70) return "Mostly Ready";
    if (score >= 55) return "Needs Practice";
    return "High Follow-Up Risk";
  };

  const handleAnalyze = () => {
    setAnalyzing(true);

    setTimeout(() => {
      setAnalyzing(false);
      setActiveTab("analysis");
