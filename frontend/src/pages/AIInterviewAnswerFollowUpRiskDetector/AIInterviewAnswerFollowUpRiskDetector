    if (risk === "Medium") {
      return "bg-orange-50 dark:bg-orange-900/10 border-orange-200 dark:border-orange-900/30";
    }

    return "bg-green-50 dark:bg-green-900/10 border-green-200 dark:border-green-900/30";
  };

