                        <span className="font-semibold">
                          Statement {index + 1}
                        </span>

                      </div>

                      <div className="flex items-center gap-3">

                        <span
                          className={`font-bold ${getRiskColor(
                            item.risk
                          )}`}
                        >
                          {item.risk} Risk
                        </span>

                        {expandedQuestion === index ? (
                          <ChevronUp size={18} />
