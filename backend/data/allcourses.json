
/**
 * In-memory Supabase mock for Vitest.
 * Supports query chaining, filters, CRUD operations, RPCs,
 * storage operations, programmed responses, and test resets.
 */

const clone = (value) => {
  if (Array.isArray(value)) return value.map(clone);
  if (value && typeof value === "object") {
    return Object.fromEntries(
      Object.entries(value).map(([key, val]) => [key, clone(val)])
    );
  }
  return value;
};

class SupabaseQueryBuilder {
  constructor({ table, store, programmed, calls }) {
    this._table = table;
    this._store = store;
    this._programmed = programmed;
    this._calls = calls;
    this._mode = null;
    this._payload = null;
    this._select = "*";
    this._filters = [];
    this._orders = [];
    this._limit = null;
    this._range = null;
    this._single = false;
    this._maybeSingle = false;
    this._options = null;
    this._execution = null;
  }

  insert(payload) {
    this._mode = "insert";
    this._payload = payload;
    return this;
  }

  update(payload) {
    this._mode = "update";
    this._payload = payload;
    return this;
  }

  upsert(payload, options = {}) {
    this._mode = "upsert";
    this._payload = payload;
    this._options = options;
    return this;
  }

  delete() {
    this._mode = "delete";
    return this;
  }

  select(columns = "*") {
    if (this._mode === null) this._mode = "select";
    this._select = columns;
    return this;
  }

  eq(col, val) { return this._filter(col, "eq", val); }
  neq(col, val) { return this._filter(col, "neq", val); }
  gt(col, val) { return this._filter(col, "gt", val); }
  gte(col, val) { return this._filter(col, "gte", val); }
  lt(col, val) { return this._filter(col, "lt", val); }
  lte(col, val) { return this._filter(col, "lte", val); }
  in(col, val) { return this._filter(col, "in", val); }
  like(col, val) { return this._filter(col, "like", val); }
  ilike(col, val) { return this._filter(col, "ilike", val); }
  is(col, val) { return this._filter(col, "is", val); }

  not(col, op, val) {
    return this._filter(col, `not:${op}`, val);
  }

  or(spec) {
    return this._filter(null, "or", spec);
  }

  _filter(col, op, val) {
    this._filters.push({ col, op, val });
    return this;
  }

  order(col, options = {}) {
    this._orders.push({
      col,
      ascending: options.ascending !== false,
    });
    return this;
  }

  limit(n) {
    this._limit = n;
    return this;
  }

  range(from, to) {
    this._range = [from, to];
    return this;
  }

  single() {
    this._single = true;
    return this._exec();
  }

  maybeSingle() {
    this._maybeSingle = true;
    return this._exec();
  }

  then(resolve, reject) {
    return this._exec().then(resolve, reject);
  }

  catch(reject) {
    return this._exec().catch(reject);
  }

  finally(callback) {
    return this._exec().finally(callback);
  }

  _splitOr(spec) {
    const parts = [];
    let current = "";
    let depth = 0;
    let quoted = false;

    for (let i = 0; i < String(spec).length; i++) {
      const ch = String(spec)[i];

      if (ch === '"' && String(spec)[i - 1] !== "\\") {
        quoted = !quoted;
      }

      if (!quoted) {
        if (ch === "(") depth++;
        if (ch === ")") depth--;

        if (ch === "," && depth === 0) {
          parts.push(current.trim());
          current = "";
          continue;
        }
      }

      current += ch;
    }

    if (current.trim()) parts.push(current.trim());
    return parts;
  }

  _parseCondition(condition) {
    let rest = String(condition).trim();
    let prefix = "";

    if (rest.startsWith("not.")) {
      prefix = "not:";
      rest = rest.slice(4);
    }

    const first = rest.indexOf(".");
    const second = rest.indexOf(".", first + 1);

    if (first < 0 || second < 0) {
      return { col: null, op: "invalid", val: null };
    }

    const col = rest.slice(0, first);
    const op = rest.slice(first + 1, second);
    let val = rest.slice(second + 1);

    if (op === "is") {
      if (val === "null") val = null;
      if (val === "true") val = true;
      if (val === "false") val = false;
    }

    if (val.length >= 2 && val.startsWith('"') && val.endsWith('"')) {
      val = val.slice(1, -1);
    }

    return { col, op: prefix + op, val };
  }

  _likeMatches(value, pattern, insensitive = false) {
    if (value == null || pattern == null) return false;

    let regex = "";
    const input = String(pattern);

    for (const ch of input) {
      if (ch === "%") regex += ".*";
      else if (ch === "_") regex += ".";
      else regex += ch.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }

    return new RegExp(`^${regex}$`, insensitive ? "i" : "")
      .test(String(value));
  }

  _matches(row, filter) {
    if (!row) return false;

    if (filter.op === "or") {
      return this._splitOr(filter.val).some((condition) => {
        condition = condition.trim();

        if (condition.startsWith("and(") && condition.endsWith(")")) {
          return this._splitOr(condition.slice(4, -1))
            .every(part => this._matches(row, this._parseCondition(part)));
        }

        return this._matches(row, this._parseCondition(condition));
      });
    }

    if (filter.col == null) return false;

    const value = row[filter.col];
    let op = filter.op;
    let negate = false;

    if (op.startsWith("not:")) {
      negate = true;
      op = op.slice(4);
    }

    let matched;

    switch (op) {
      case "eq":
        matched = value === filter.val;
        break;
      case "neq":
        matched = value !== filter.val;
        break;
      case "is":
        matched = filter.val === null
          ? value == null
          : value === filter.val;
        break;
      case "gt":
        matched = value != null && value > filter.val;
        break;
      case "gte":
        matched = value != null && value >= filter.val;
        break;
      case "lt":
        matched = value != null && value < filter.val;
        break;
      case "lte":
        matched = value != null && value <= filter.val;
        break;
      case "like":
        matched = this._likeMatches(value, filter.val);
        break;
      case "ilike":
        matched = this._likeMatches(value, filter.val, true);
        break;
      case "in": {
        let values = filter.val;

        if (typeof values === "string") {
          values = values.replace(/^\s*\(|\)\s*$/g, "");
          values = values
            ? values.split(",").map(v => v.trim().replace(/^["']|["']$/g, ""))
            : [];
        }

        matched = Array.isArray(values) && values.includes(value);
        break;
      }
      default:
        matched = false;
    }

    return negate ? !matched : matched;
  }

  _error(message, code) {
    return {
      data: null,
      error: {
        message,
        ...(code ? { code } : {}),
      },
    };
  }

  async _exec() {
    if (this._execution) return this._execution;
    this._execution = this._execute();
    return this._execution;
  }

  async _execute() {
    this._calls.push({
      table: this._table,
      mode: this._mode,
      payload: clone(this._payload),
      select: this._select,
      filters: clone(this._filters),
      orders: clone(this._orders),
      order: this._orders.length
        ? { ...this._orders[this._orders.length - 1] }
        : null,
      limit: this._limit,
      range: this._range ? [...this._range] : null,
      single: this._single,
      maybeSingle: this._maybeSingle,
    });

    const errors = this._programmed.matchingErrors;
    const errorIndex = errors?.findIndex(
      item => item.table === this._table && item.mode === this._mode
    ) ?? -1;

    if (errorIndex !== -1) {
      const [item] = errors.splice(errorIndex, 1);
      return { data: null, error: item.error };
    }

    if (Object.hasOwn(this._programmed, "nextError")) {
      const error = this._programmed.nextError;
      delete this._programmed.nextError;
      return { data: null, error };
    }

    if (Object.hasOwn(this._programmed, "nextData")) {
      const data = this._programmed.nextData;
      delete this._programmed.nextData;
      return { data, error: null };
    }

    this._store[this._table] ??= [];
    const table = this._store[this._table];

    // INSERT
    if (this._mode === "insert") {
      const inputs = Array.isArray(this._payload)
        ? this._payload
        : [this._payload];

      if (inputs.some(row => !row || typeof row !== "object")) {
        return this._error("Invalid insert payload");
      }

      const rows = inputs.map((input, index) => {
        const row = clone(input);
        row.id ??= `mock-${this._table}-${table.length + index + 1}`;
        row.created_at ??= new Date().toISOString();
        return row;
      });

      table.push(...rows);

      if (this._single) {
        return rows.length
          ? { data: rows[0], error: null }
          : this._error("No rows returned", "PGRST116");
      }

      if (this._maybeSingle) {
        return { data: rows[0] ?? null, error: null };
      }

      return { data: rows, error: null };
    }

    // UPSERT
    if (this._mode === "upsert") {
      const inputs = Array.isArray(this._payload)
        ? this._payload
        : [this._payload];

      const fields = this._options?.onConflict
        ? String(this._options.onConflict).split(",").map(s => s.trim())
        : ["id", "user_id", "event_id"];

      const result = [];

      for (const input of inputs) {
        if (!input || typeof input !== "object") {
          return this._error("Invalid upsert payload");
        }

        const row = clone(input);
        const usableFields = fields.filter(f => row[f] !== undefined);

        // All specified conflict columns must match.
        const index = usableFields.length
          ? table.findIndex(existing =>
              usableFields.every(field => existing[field] === row[field])
            )
          : -1;

        if (index >= 0) {
          table[index] = { ...table[index], ...row };
          result.push(table[index]);
        } else {
          table.push(row);
          result.push(row);
        }
      }

      return { data: result, error: null };
    }

    // UPDATE
    if (this._mode === "update") {
      const rows = table.filter(row =>
        this._filters.every(filter => this._matches(row, filter))
      );

      for (const row of rows) {
        Object.assign(row, clone(this._payload));
      }

      if (this._single && rows.length !== 1) {
        return this._error("Expected exactly one row", "PGRST116");
      }

      return {
        data: this._single || this._maybeSingle ? rows[0] ?? null : rows,
        error: null,
      };
    }

    // DELETE
    if (this._mode === "delete") {
      const deleted = table.filter(row =>
        this._filters.every(filter => this._matches(row, filter))
      );

      this._store[this._table] = table.filter(
        row => !deleted.includes(row)
      );

      return { data: deleted, error: null, count: deleted.length };
    }

    // SELECT
    if (this._mode === "select" || this._mode === null) {
      let rows = table.filter(row =>
        this._filters.every(filter => this._matches(row, filter))
      );

      if (this._orders.length) {
        rows = [...rows].sort((a, b) => {
          for (const { col, ascending } of this._orders) {
            if (a[col] === b[col]) continue;

            const comparison =
              a[col] == null ? -1 :
              b[col] == null ? 1 :
              a[col] > b[col] ? 1 : -1;

            return ascending ? comparison : -comparison;
          }

          return 0;
        });
      }

      const count = rows.length;

      if (this._range) {
        const [from, to] = this._range;
        rows = rows.slice(from, to + 1);
      }

      if (this._limit != null) {
        rows = rows.slice(0, this._limit);
      }

      if (this._single) {
        if (rows.length !== 1) {
          return this._error("Expected exactly one row", "PGRST116");
        }

        return { data: rows[0], error: null, count: 1 };
      }

      if (this._maybeSingle) {
        if (rows.length > 1) {
          return this._error("Expected at most one row", "PGRST116");
        }

        return { data: rows[0] ?? null, error: null, count: rows.length };
      }

      return { data: rows, error: null, count };
    }

    return this._error(`Unhandled mode: ${this._mode}`);
  }
}

// =================================================================
// CREATE MOCK
// =================================================================

export function createSupabaseMock(initialStore = {}) {
  const initialSnapshot = clone(initialStore);
  const store = clone(initialSnapshot);
  const calls = [];
  const programmed = {};

  const supabase = {
    from(table) {
      store[table] ??= [];

      return new SupabaseQueryBuilder({
        table,
        store,
        programmed,
        calls,
      });
    },

    async rpc(fnName, args = {}) {
      calls.push({ rpc: fnName, args: clone(args) });

      if (Object.hasOwn(programmed, "nextRpcError")) {
        const error = programmed.nextRpcError;
        delete programmed.nextRpcError;
        return { data: null, error };
      }

      if (Object.hasOwn(programmed, "nextError")) {
        const error = programmed.nextError;
        delete programmed.nextError;
        return { data: null, error };
      }

      if (Object.hasOwn(programmed, "nextData")) {
        const data = programmed.nextData;
        delete programmed.nextData;
        return { data, error: null };
      }

      // Accept a bid.
      if (fnName === "accept_bid_tx" && args.p_order_id) {
        store.orders ??= [];
        store.load_offers ??= [];

        const index = store.orders.findIndex(
          order => order.id === args.p_order_id
        );

        if (index === -1) return { data: null, error: null };

        const order = store.orders[index];

        const updated = {
          ...order,
          driver_id: args.p_driver_id,
          status: "active",
          ...(typeof order.version === "number"
            ? { version: order.version + 1 }
            : {}),
        };

        store.orders[index] = updated;

        if (args.p_load_id) {
          const offerIndex = store.load_offers.findIndex(
            offer => offer.id === args.p_load_id
          );

          if (offerIndex !== -1) {
            store.load_offers[offerIndex] = {
              ...store.load_offers[offerIndex],
              status: "claimed",
            };
          }
        }

        return { data: updated, error: null };
      }

      // Register device token.
      if (fnName === "register_device_token") {
        store.user_devices ??= [];
        store.profiles ??= [];

        const now = new Date().toISOString();
        const userId = args.p_user_id;
        const token = args.p_fcm_token;
        const deviceId = args.p_device_id ?? null;

        if (deviceId) {
          for (const device of store.user_devices) {
            if (
              device.device_id === deviceId &&
              device.user_id === userId &&
              device.fcm_token !== token &&
              device.is_active !== false
            ) {
              device.is_active = false;
              device.deactivated_at = now;
              device.updated_at = now;
            }
          }
        }

        let device = store.user_devices.find(
          item => item.fcm_token === token
        );

        if (!device) {
          device = { id: `device-${store.user_devices.length + 1}` };
          store.user_devices.push(device);
        }

        Object.assign(device, {
          user_id: userId,
          fcm_token: token,
          platform: args.p_platform ?? "android",
          device_id: deviceId,
          metadata: args.p_metadata ?? null,
          is_active: true,
          deactivated_at: null,
          last_seen: args.p_last_seen ?? now,
          created_at: device.created_at ?? now,
          updated_at: now,
        });

        if (args.p_prev_user_id && args.p_prev_user_id !== userId) {
          const previous = store.profiles.find(
            profile => profile.id === args.p_prev_user_id
          );

          if (previous) {
            previous.fcm_token = null;
            previous.fcm_token_updated_at = now;
          }
        }

        const profile = store.profiles.find(
          item => item.id === userId
        );

        if (profile) {
          profile.fcm_token = token;
          profile.fcm_token_updated_at = now;
        }

        return { data: device, error: null };
      }

      // Unregister device token.
      if (fnName === "unregister_device_token") {
        store.user_devices ??= [];
        store.profiles ??= [];

        const now = new Date().toISOString();
        const userId = args.p_user_id;
        const token = args.p_fcm_token;

        const device = store.user_devices.find(
          item => item.fcm_token === token && item.user_id === userId
        );

        let count = 0;

        if (device) {
          device.is_active = false;
          device.deactivated_at = now;
          device.updated_at = now;
          count = 1;
        }

        const next = store.user_devices.find(
          item =>
            item.user_id === userId &&
            item.is_active !== false &&
            item.fcm_token !== token
        );

        const profile = store.profiles.find(
          item => item.id === userId
        );

        if (profile && profile.fcm_token === token) {
          profile.fcm_token = next?.fcm_token ?? null;
          profile.fcm_token_updated_at = now;
        }

        return { data: count, error: null };
      }

      // Append maintenance photos.
      if (fnName === "append_maintenance_photos" && args.p_ticket_id) {
        store.truck_maintenance_tickets ??= [];

        const index = store.truck_maintenance_tickets.findIndex(
          ticket => ticket.id === args.p_ticket_id
        );

        if (index === -1) return { data: null, error: null };

        const ticket = store.truck_maintenance_tickets[index];

        store.truck_maintenance_tickets[index] = {
          ...ticket,
          photo_urls: [
            ...(ticket.photo_urls ?? []),
            ...(args.p_new_paths ?? []),
          ],
        };

        return {
          data: store.truck_maintenance_tickets[index],
          error: null,
        };
      }

      // Update order status transaction.
      if (fnName === "update_order_status_tx" && args.p_order_id) {
        store.orders ??= [];

        const index = store.orders.findIndex(
          order => order.id === args.p_order_id
        );

        if (index === -1) return { data: [], error: null };

        const current = store.orders[index];

        if (
          args.p_not_statuses?.includes(current.status)
        ) {
          return { data: [], error: null };
        }

        if (
          args.p_escrow_in_statuses &&
          (
            current.escrow_status == null ||
            !args.p_escrow_in_statuses.includes(current.escrow_status)
          )
        ) {
          return { data: [], error: null };
        }

        const updated = {
          ...current,
          status: args.p_status,
          updated_at: new Date().toISOString(),
          version: (current.version ?? 0) + 1,
        };

        const optionalFields = [
          ["p_cancellation_reason", "cancellation_reason"],
          ["p_cancellation_fee", "cancellation_fee"],
          ["p_escrow_status", "escrow_status"],
          ["p_escrow_refund_attempts", "escrow_refund_attempts"],
          ["p_refund_tx_hash", "refund_tx_hash"],
          [
            "p_escrow_refund_last_attempt_at",
            "escrow_refund_last_attempt_at",
          ],
          ["p_escrow_refunded_at", "escrow_refunded_at"],
          ["p_escrow_refund_submitted_at", "escrow_refund_submitted_at"],
        ];

        for (const [param, field] of optionalFields) {
          if (args[param] != null) updated[field] = args[param];
        }

        updated.escrow_refund_error = args.p_clear_escrow_refund_error
          ? null
          : (
              args.p_escrow_refund_error ??
              current.escrow_refund_error ??
              null
            );

        store.orders[index] = updated;

        return { data: [updated], error: null };
      }

      // Create order, timeline, and marketplace offer.
      if (fnName === "create_order_tx" && args.p_order_display_id) {
        store.orders ??= [];
        store.order_timeline ??= [];
        store.load_offers ??= [];

        const now = new Date().toISOString();

        const order = {
          id: `mock-order-${store.orders.length + 1}`,
          order_display_id: args.p_order_display_id,
          customer_id: args.p_customer_id,
          status: "pending",
          created_at: now,
          updated_at: now,
          pickup_address: args.p_pickup_address,
          pickup_lat: args.p_pickup_lat,
          pickup_lng: args.p_pickup_lng,
          drop_address: args.p_drop_address,
          drop_lat: args.p_drop_lat,
          drop_lng: args.p_drop_lng,
          pickup_date: args.p_pickup_date,
          pickup_time: args.p_pickup_time,
          goods_type: args.p_goods_type,
          weight_tonnes: args.p_weight_tonnes,
          is_stackable: args.p_is_stackable,
          is_fragile: args.p_is_fragile,
          special_requirements: args.p_special_requirements,
          base_freight: args.p_base_freight,
          toll_estimate: args.p_toll_estimate,
          platform_fee: args.p_platform_fee,
          total_amount: args.p_total_amount,
          estimated_price: args.p_estimated_price,
        };

        store.orders.push(order);

        const milestones = [
          ["Order Placed", true, 10],
          ["Truck Assigned", false, 20],
          ["En Route to Pickup", false, 30],
          ["Arrived at Pickup", false, 35],
          ["Goods Loaded", false, 40],
          ["In Transit", false, 50],
          ["Arriving", false, 55],
          ["Delivered", false, 60],
        ];

        for (const [milestone, completed, sort_order] of milestones) {
          store.order_timeline.push({
            order_display_id: args.p_order_display_id,
            milestone,
            milestone_time: completed ? now : null,
            completed,
            sort_order,
          });
        }

        store.load_offers.push({
          order_display_id: args.p_order_display_id,
          customer_id: args.p_customer_id,
          customer_name: args.p_customer_name,
          pickup_address: args.p_pickup_address,
          drop_address: args.p_drop_address,
          goods_type: args.p_goods_type,
          freight_value: args.p_total_amount,
          status: "available",
        });

        return { data: order, error: null };
      }

      // Update order and associated load offer.
      if (
        fnName === "update_order_and_load_offer" &&
        args.p_order_id
      ) {
        store.orders ??= [];
        store.load_offers ??= [];

        const index = store.orders.findIndex(
          order => order.id === args.p_order_id
        );

        if (index === -1) {
          return {
            data: null,
            error: { message: "Order not found" },
          };
        }

        store.orders[index] = {
          ...store.orders[index],
          ...(args.p_order_updates ?? {}),
        };

        const offerIndex = store.load_offers.findIndex(
          offer =>
            offer.order_display_id === args.p_order_display_id
        );

        if (offerIndex !== -1) {
          store.load_offers[offerIndex] = {
            ...store.load_offers[offerIndex],
            ...(args.p_offer_updates ?? {}),
          };
        }

        return { data: store.orders[index], error: null };
      }

      return { data: null, error: null };
    },

    storage: {
      from(bucket) {
        return {
          async upload(path, buffer, options = {}) {
            calls.push({
              storageUpload: { bucket, path, options: clone(options) },
            });

            if (Object.hasOwn(programmed, "nextStorageError")) {
              const error = programmed.nextStorageError;
              delete programmed.nextStorageError;
              return { data: null, error };
            }

            store.__storageObjects ??= [];

            store.__storageObjects.push({
              bucket,
              path,
              buffer,
              options: clone(options),
            });

            return { data: { path }, error: null };
          },

          async createSignedUrl(path, expiresIn) {
            calls.push({
              storageSignedUrl: { bucket, path, expiresIn },
            });

            return {
              data: {
                signedUrl:
                  `https://mock-storage.supabase.co/storage/v1/object/sign/${bucket}/${path}?token=mock-token`,
              },
              error: null,
            };
          },

          async remove(paths) {
            calls.push({
              storageRemove: { bucket, paths: clone(paths) },
            });

            store.__storageObjects ??= [];

            const list = Array.isArray(paths) ? paths : [paths];

            const removed = store.__storageObjects.filter(
              object =>
                object.bucket === bucket && list.includes(object.path)
            );

            store.__storageObjects = store.__storageObjects.filter(
              object =>
                object.bucket !== bucket || !list.includes(object.path)
            );

            return {
              data: removed.map(object => ({ name: object.path })),
              error: null,
            };
          },
        };
      },
    },
  };

  return {
    supabase,
    store,
    calls,

    reset() {
      for (const key of Object.keys(store)) delete store[key];
      Object.assign(store, clone(initialSnapshot));
      calls.length = 0;

      for (const key of Object.keys(programmed)) {
        delete programmed[key];
      }
    },

    programError(msg = "mock error") {
      programmed.nextError = { message: msg };
    },

    programErrorFor(table, mode, msg = "mock error") {
      programmed.matchingErrors ??= [];
      programmed.matchingErrors.push({
        table,
        mode,
        error: { message: msg },
      });
    },

    programRpcError(msg = "mock error") {
      programmed.nextRpcError = { message: msg };
    },

    programStorageError(msg = "mock error") {
      programmed.nextStorageError = { message: msg };
    },

    programData(data) {
      programmed.nextData = data;
    },
  };
}
